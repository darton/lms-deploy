[DOMAIN_PLACEHOLDER]

user = APP_USER_PLACEHOLDER
group = APP_GROUP_PLACEHOLDER

listen = /run/php-fpm/DOMAIN_PLACEHOLDER.sock
listen.acl_users = apache

pm = dynamic
pm.max_children = 50
pm.start_servers = 5
pm.min_spare_servers = 5
pm.max_spare_servers = 35

php_admin_value[error_log] = /var/log/php-fpm/DOMAIN_PLACEHOLDER-error.log
php_admin_flag[log_errors] = on

php_admin_value[open_basedir] = /bin/who:/bin/uname:/proc/cpuinfo:/proc/net/arp:/proc/loadavg:/proc/uptime:WEB_ROOT_PLACEHOLDER:/etc/lms:APP_ROOT_PLACEHOLDER/var/sessions:APP_ROOT_PLACEHOLDER/var/tmp:BACKUP_DIR_PLACEHOLDER
php_admin_value[session.save_path] = APP_ROOT_PLACEHOLDER/var/sessions
php_admin_value[upload_tmp_dir] = APP_ROOT_PLACEHOLDER/var/tmp
php_admin_value[sys_tmp_dir] = APP_ROOT_PLACEHOLDER/var/tmp
php_admin_value[memory_limit] = 512M
php_admin_value[upload_max_filesize] = 32M
php_admin_value[post_max_size] = 32M
php_admin_value[max_execution_time] = 120
